{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react", "react-native"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["App.tsx", "src", "scripts"],
  "exclude": ["node_modules", "supabase/functions", "worker"]
}
