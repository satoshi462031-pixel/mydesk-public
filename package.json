{
  "name": "mydesk",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/tunnel.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check --no-config --no-lock --node-modules-dir=none \"supabase/functions/*/index.ts\"",
    "lint": "eslint App.tsx src scripts tests",
    "check": "npm run typecheck && npm run lint && npm run test:all",
    "test:app": "tsx --test tests/*.test.ts",
    "test:typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "test:all": "npm run test:typecheck && npm run test:app && npm run test:db && npm --prefix worker test -- --run",
    "test:db": "node scripts/validateWebSecurityDb.mjs && node scripts/validateAbuseProtectionDb.mjs",
    "import:products": "tsx scripts/importRakuten.ts",
    "import:genres": "tsx scripts/importRakutenGenres.ts",
    "audit:public-desks": "tsx scripts/auditPublicDeskStats.ts",
    "feedback:pull": "tsx scripts/pullFeedback.ts",
    "moderate": "tsx scripts/moderation.ts",
    "audit:connectivity": "tsx scripts/auditHostConnectivity.ts",
    "audit:audio": "tsx scripts/auditAudioInterfaces.ts",
    "audit:battery": "tsx scripts/auditMobileBatteries.ts",
    "audit:power-strip": "tsx scripts/auditPowerStrips.ts",
    "audit:consoles": "tsx scripts/auditConsoleEnvironments.ts",
    "audit:standing-desks": "tsx scripts/auditStandingDeskEnvironments.ts",
    "audit:powered-desks": "tsx scripts/auditPoweredDeskEnvironments.ts",
    "audit:wireless-chargers": "tsx scripts/auditWirelessChargerEnvironments.ts",
    "audit:docking-monitors": "tsx scripts/auditDockingMonitorEnvironments.ts",
    "audit:keyboard": "tsx scripts/auditKeyboardPorts.ts",
    "audit:ports": "tsx scripts/auditProductPorts.ts",
    "audit:product-cable-pairs": "tsx scripts/auditAllProductCablePairs.ts",
    "repair:ports": "tsx scripts/repairLowConfidenceProductPorts.ts",
    "backfill:brands": "tsx scripts/backfillProductBrands.ts",
    "backfill:device-brands": "tsx scripts/backfillDeviceBrands.ts",
    "audit:brands": "tsx scripts/auditBrandIdentity.ts",
    "audit:colors": "tsx scripts/auditColors.ts",
    "audit:icons": "tsx scripts/auditIcons.ts",
    "audit:icon-buttons": "tsx scripts/auditIconButtons.ts",
    "audit:spacing": "tsx scripts/auditSpacing.ts",
    "audit:text-fields": "tsx scripts/auditTextFields.ts",
    "audit:radius": "tsx scripts/auditRadius.ts",
    "audit:header-buttons": "tsx scripts/auditHeaderButtons.ts",
    "audit:function-grants": "tsx scripts/auditFunctionGrants.ts",
    "audit:prod-surface": "tsx scripts/auditProductionSurface.ts",
    "audit:collapsible-header": "tsx scripts/auditCollapsibleHeader.ts",
    "audit:coach-targets": "tsx scripts/auditCoachTargets.ts",
    "audit:nav-after-await": "tsx scripts/auditNavigationAfterAwait.ts",
    "audit:photo-aspect": "tsx scripts/auditPhotoAspect.ts",
    "audit:layout-compare": "tsx scripts/compareMapLayoutMetrics.ts",
    "bench:layout": "tsx scripts/benchLayout.ts",
    "bench:history": "tsx scripts/benchHistory.ts",
    "bench:layout:profile": "esbuild scripts/benchLayout.ts --bundle --platform=node --format=cjs --outfile=tmp/benchLayout.cjs --log-level=warning && node tmp/benchLayout.cjs",
    "publish:demo": "tsx scripts/publishDemoDesks.ts",
    "build:icon-optics": "tsx scripts/buildIconOptics.ts",
    "build:onboarding-wiring": "tsx scripts/buildOnboardingWiring.ts",
    "metrics:snapshot": "tsx scripts/createMetricsSnapshot.ts",
    "metrics:campaign": "tsx scripts/createAppStoreCampaign.ts",
    "screenshots": "tsx scripts/resizeScreenshots.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/elements": "^1.3.31",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "posthog-react-native": "^4.49.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkeys": "0.4.2",
    "react-native-purchases": "^10.4.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.19.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.5",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.1.0",
    "@types/react": "~19.1.10",
    "@types/uuid": "^10.0.0",
    "budoux": "^0.9.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "browserslist": "^4.28.8",
    "postcss": "^8.5.24",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  },
  "private": true
}
