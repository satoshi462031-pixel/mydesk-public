EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_PUBLIC_API_URL=https://mydesk.page
NEXT_PUBLIC_PUBLIC_API_URL=https://mydesk.page
# Supabaseのパスキー設定、ドメイン関連付け、各OSのネイティブビルドを準備してからtrueにする。
EXPO_PUBLIC_PASSKEY_ENABLED=false
# Android通知はFCM設定済みのネイティブビルドでのみtrue。全体の通知公開スイッチも必要。
EXPO_PUBLIC_ANDROID_PUSH_ENABLED=false
# Firebaseのgoogle-services.jsonへのパス。EASではFile型の環境変数を使う。
GOOGLE_SERVICES_JSON=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=
EXPO_PUBLIC_REVENUECAT_YEARLY_PRODUCT_ID=
# 各ストアの商品ページが公開された後だけ true にする。公開前は評価リンクを表示しない。
EXPO_PUBLIC_APP_STORE_REVIEW_ENABLED=false
EXPO_PUBLIC_PLAY_STORE_REVIEW_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# US: https://us.i.posthog.com / EU: https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentryのソースマップ用。SENTRY_AUTH_TOKENはEASのSensitive secretへ入れる。
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── 購入リンク（アプリにバンドルされる）────────────────────────
# 商品マスタにリンクが無いときに出す検索リンクへ成果報酬を紐づける。
# 未設定でもリンクは出る（報酬が付かないだけ）
EXPO_PUBLIC_RAKUTEN_RAFCID=
# Amazon アソシエイトのトラッキングID。.co.jp と .com はプログラムが別なので
# タグも別に発行される。未設定の国では Amazon の検索リンクを出さない
EXPO_PUBLIC_AMAZON_ASSOCIATE_TAG_JP=
EXPO_PUBLIC_AMAZON_ASSOCIATE_TAG=

# ─── 商品マスタ取り込み（scripts/importRakuten.ts）────────────────
# 手元PCでのみ使う。アプリには一切バンドルされない（EXPO_PUBLIC_ を付けないこと）
# Supabase ダッシュボード > Project Settings > API の service_role キー
SUPABASE_SERVICE_ROLE_KEY=
# https://webservice.rakuten.co.jp/app/list のアプリID（UUID形式）とアクセスキー。
# 2026年2月の刷新で両方必須になった（片方だけだと400）。
# 「許可されたIPアドレス」には実行するPCのグローバルIPを登録する
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID。未設定でも動くが、通常の商品ページURLになり報酬は発生しない
RAKUTEN_AFFILIATE_ID=

# ─── サーバー専用secret（実値は.envではなく各サービスのsecret管理へ）────────
# supabase secrets set で delete-account Edge Function に設定する
REVENUECAT_SECRET_API_KEY=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.ash462031.mydesk
# p8の改行を含むPEM。リポジトリには実値を保存しない
APPLE_PRIVATE_KEY=

# wrangler secret put でWorkerに設定する
TURNSTILE_SECRET_KEY=
WAITLIST_RATE_LIMIT_SECRET=
